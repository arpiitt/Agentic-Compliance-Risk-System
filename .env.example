# ─── LLM ───────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ─── News ──────────────────────────────────────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key_here

# ─── SEC EDGAR ─────────────────────────────────────────────────────────────────
SEC_USER_AGENT="ComplianceBot admin@example.com"

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://compliance:compliance@localhost:5432/compliance_db
DATABASE_SYNC_URL=postgresql://compliance:compliance@localhost:5432/compliance_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=policy_kb

# ─── Guardrails ────────────────────────────────────────────────────────────────
MAX_RETRIES=3
TOKEN_BUDGET=150000
COST_BUDGET_USD=2.00
TIMEOUT_SECONDS=30
MAX_VERIFIER_LOOPS=2

# ─── Cache TTLs (seconds) ──────────────────────────────────────────────────────
RETRIEVAL_CACHE_TTL=21600
LLM_CACHE_TTL=86400

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_GET=60/minute
